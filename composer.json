{
    "name": "quineworks/taxlane",
    "description": "Official PHP SDK for TaxLane's free Nigeria tax calculator API (PAYE, VAT, WHT, CIT, CGT & 6 more).",
    "type": "library",
    "license": "MIT",
    "homepage": "https://taxlane.ng/developers",
    "keywords": [
        "nigeria",
        "tax",
        "paye",
        "payroll",
        "vat",
        "withholding-tax",
        "cit",
        "cgt",
        "stamp-duty",
        "import-duty",
        "tax-calculator",
        "sdk"
    ],
    "support": {
        "issues": "https://github.com/quineworks/tax-lane/issues",
        "source": "https://github.com/quineworks/taxlane-php"
    },
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "TaxLane\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TaxLane\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
